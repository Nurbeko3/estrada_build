Options -MultiViews

# nginx statik fayllarni (index.html) Apache'ni chetlab o'tib to'g'ridan-to'g'ri
# beradi — shu sababli .htaccess header'lari ishlamay qoladi. index.php orqali
# bosh sahifa har doim Apache/PHP'dan o'tishini ta'minlaymiz (build skripti
# dist/index.html'ni index.php + app.html'ga aylantiradi, pastdagi
# DirectoryIndex va RewriteRule shunga moslashtirilgan).
DirectoryIndex index.php index.html

# Xavfsizlik HTTP header'lari (securityheaders.com tekshiruvi)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https://estrada-tan.vercel.app; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://estrada-tan.vercel.app; frame-src 'self' https://www.youtube.com https://open.spotify.com https://yandex.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # Server versiyasini oshkor qilmaslik
  Header always unset X-Powered-By
</IfModule>

# .webmanifest uchun to'g'ri MIME turi (Apache'da sukut bo'yicha yo'q)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# Gzip siqish
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json application/xml text/xml
</IfModule>

# Brauzer keshi (PageSpeed: "Use efficient cache lifetimes")
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType audio/mpeg "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

RewriteEngine On
RewriteBase /

# Keraksiz eski WordPress URL'larni Google'dan chiqarish uchun 410 Gone
RewriteRule ^kurslar-bakalavr/?$ - [G,L]
RewriteRule ^2022/06/?$ - [G,L]
RewriteRule ^2022/06/.*$ - [G,L]
RewriteRule ^portfolio-grid/?$ - [G,L]
RewriteRule ^portfolio/beff-baffer-construction/?$ - [G,L]
RewriteRule ^savatcha/?$ - [G,L]

# React JS SPA fallback (index.php orqali — pastdagi izohga qarang)
RewriteRule ^index\.php$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]